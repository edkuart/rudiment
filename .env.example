# ============================================================
# RUDIMENT — Environment Variables Reference
# Copy to .env in each app directory and fill in the values
# ============================================================

# ---- App ----
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ---- Database (Docker default) ----
DATABASE_URL=postgresql://rudiment:rudiment_dev@localhost:5432/rudiment_db

# ---- Redis (Docker default) ----
REDIS_URL=redis://:rudiment_dev@localhost:6379

# ---- Auth (generate with: openssl rand -base64 64) ----
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_ANNUAL_PRICE_ID=price_...
STRIPE_LIFETIME_PRICE_ID=price_...

# ---- Mux (https://dashboard.mux.com) ----
MUX_TOKEN_ID=...
MUX_TOKEN_SECRET=...
MUX_SIGNING_KEY_ID=...
MUX_SIGNING_PRIVATE_KEY=...

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=rudiment-media
R2_PUBLIC_URL=https://media.rudiment.pro

# ---- Email (https://resend.com) ----
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@rudiment.pro

# ---- Sentry ----
SENTRY_DSN=https://...@sentry.io/...

# ---- Next.js Public (prefix with NEXT_PUBLIC_) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
