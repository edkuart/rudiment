{
  "name": "@rudiment/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@rudiment/types": "*",
    "express": "^4.21.2",
    "zod": "^3.24.1",
    "drizzle-orm": "^0.39.1",
    "pg": "^8.13.1",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^3.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "@sentry/node": "^8.51.0"
  },
  "devDependencies": {
    "@rudiment/config": "*",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5",
    "drizzle-kit": "^0.30.2"
  }
}
