{
  "name": "rudiment",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:frontend": "npm run dev -w @rudiment/frontend",
    "dev:backend": "npm run dev -w @rudiment/backend",
    "build": "turbo build",
    "build:frontend": "npm run build -w @rudiment/frontend",
    "build:backend": "npm run build -w @rudiment/backend",
    "start:frontend": "npm run start -w @rudiment/frontend",
    "start:backend": "npm run start -w @rudiment/backend",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "typecheck:frontend": "npm run typecheck -w @rudiment/frontend",
    "typecheck:backend": "npm run typecheck -w @rudiment/backend",
    "test": "turbo test",
    "test:backend": "npm run test -w @rudiment/backend",
    "seed:plans": "npm run seed:plans -w @rudiment/backend",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "npm run db:generate -w @rudiment/backend",
    "db:migrate": "npm run db:migrate -w @rudiment/backend",
    "db:studio": "npm run db:studio -w @rudiment/backend"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2"
}
